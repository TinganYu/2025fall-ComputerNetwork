{
  "manifest_version": 3,
  "name": "FocusTyping",
  "version": "1.0",
  "description": "智慧專注寫作助手",
  "permissions": ["activeTab", "scripting", "contextMenus","storage"],
  "host_permissions":["https://two025fall-computernetwork.onrender.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "pop up"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
