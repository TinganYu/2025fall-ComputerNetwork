{
  "manifest_version": 3,
  "name": "Typing Stress Demo",
  "version": "1.0",
  "description": "根據打字行為簡單估測壓力",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Typing Stress"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
